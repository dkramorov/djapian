SET(prefix "/usr/local")
SET(exec_prefix "${prefix}")
SET(XAPIAN_SHARED ON CACHE BOOL "Use shared xapian library")
SET(XAPIAN_SHARED_LIBRARY "${exec_prefix}/lib/libxapian.dylib" CACHE FILEPATH "Shared Xapian library")
SET(XAPIAN_STATIC_LIBRARY "${exec_prefix}/lib/libxapian.a" CACHE FILEPATH "Static Xapian library")
SET(XAPIAN_STATIC_DEP_LIBS ";z" CACHE STRING "Dependencies of static xapian library")
IF(XAPIAN_SHARED)
    SET(XAPIAN_LIBRARIES "${XAPIAN_SHARED_LIBRARY}")
ELSE()
    SET(XAPIAN_LIBRARIES "${XAPIAN_STATIC_LIBRARY};${XAPIAN_STATIC_DEP_LIBS}")
ENDIF()
SET(XAPIAN_INCLUDE_DIR "${prefix}/include" CACHE PATH "Include path for Xapian")
SET(XAPIAN_FOUND ON)
